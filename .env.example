# ─────────────────────────────────────────────────────────────────────────────
# FL77 FinOps — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores antes de subir o projeto.
# NUNCA faça commit do arquivo .env — ele já está no .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ambiente ─────────────────────────────────────────────────────────────────
# "production" exige APP_SESSION_SECRET definida e ativa cookie Secure.
# "development" usa chave gerada aleatoriamente a cada restart (OK para local).
ENV=production

# ── Segurança ─────────────────────────────────────────────────────────────────
# Chave HMAC para assinar os cookies de sessão.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# OBRIGATÓRIA quando ENV=production.
APP_SESSION_SECRET=substitua-por-uma-chave-longa-e-aleatoria

# ── Banco de dados ────────────────────────────────────────────────────────────
# SQLite (padrão — banco salvo no volume Docker /data):
DATABASE_URL=sqlite:////data/financeiro.db

# PostgreSQL (recomendado para múltiplos usuários ou escala):
# DATABASE_URL=postgresql://usuario:senha@host:5432/finops

# ── Rate limiting do login ────────────────────────────────────────────────────
# Número máximo de tentativas de login por IP dentro da janela de tempo.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=60

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Token gerado no painel Cloudflare Zero Trust → Access → Tunnels.
# Veja o DEPLOY.md para instruções passo a passo.
CLOUDFLARE_TUNNEL_TOKEN=cole-aqui-o-token-do-cloudflare-tunnel
